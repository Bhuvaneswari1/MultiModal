# Copy to .env; never commit real secrets. No paid calls in demo mode.
APP_MODE=demo
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
TEXT_MODEL=gpt-4.1-mini
ASR_MODEL=whisper-1
TTS_MODEL=tts-1
IMAGE_MODEL=gpt-image-1
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-claims-workshop
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Auth for the local workshop API and reviewer endpoint; change before sharing.
APP_API_TOKEN=local-workshop-token
REVIEWER_TOKEN=local-reviewer-token
